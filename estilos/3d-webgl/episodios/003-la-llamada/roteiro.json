{
  "titulo": "La llamada de las 3:17",
  "formato": "9:16",
  "idioma": "es",
  "parte": 1,
  "vozes": {
    "narrador": {"voz": "3f45a7fd7a614655a61eb7027b955783", "origem": "Fish: voz de locutor k (es)"},
    "mama": {"voz": "e296306da5d449999f6e35c2b9f60aea", "origem": "Fish: Colombiana IA (es)", "efeito": "detras_da_porta"}
  },
  "falas": [
    {"id": "l1", "voz": "narrador", "texto": "Todas las noches, a las tres y diecisiete, mi teléfono suena.", "tela": "celular_llamada", "destaque": ["tres", "diecisiete"], "depois": 0.35},
    {"id": "l2", "voz": "narrador", "texto": "Y la llamada viene... de mi propio número.", "tela": "celular_numero", "destaque": ["propio", "número"], "depois": 0.55},
    {"id": "l3", "voz": "narrador", "texto": "Durante un mes no contesté. Anoche, contesté.", "tela": "cuarto", "destaque": ["contesté."], "depois": 0.45, "evento_fim": "atender"},
    {"id": "l4", "voz": "narrador", "texto": "Del otro lado, alguien respiraba. Y entonces, con mi misma voz, me susurró:", "tela": "celular_atendido", "destaque": ["respiraba.", "mi", "misma", "voz,"], "depois": 0.4, "antes": 0.6},
    {"id": "l5", "voz": "narrador", "direcao": "[whispering]", "texto": "No abras la puerta. Lo que está afuera... ya sabe tu nombre.", "tela": "porta_aproxima", "destaque": ["puerta.", "nombre."], "sussurro": true, "depois": 0.6},
    {"id": "l6", "voz": "narrador", "texto": "Colgué. Y en ese momento, golpearon la puerta de mi cuarto.", "tela": "cuarto_porta", "destaque": ["golpearon"], "depois": 0.3, "evento_inicio": "desligar", "evento_fim": "golpes"},
    {"id": "l7", "voz": "narrador", "texto": "Tres golpes. Muy despacio.", "tela": "porta_baixo", "destaque": ["Tres", "golpes."], "antes": 2.4, "depois": 0.7, "evento_inicio": "pes"},
    {"id": "l8", "voz": "mama", "direcao": "[scared, whispering]", "texto": "Hijo... ábreme. Tengo miedo.", "tela": "macaneta", "destaque": ["ábreme."], "atras_da_porta": true, "depois": 0.7, "evento_fim": "macaneta"},
    {"id": "l9", "voz": "narrador", "texto": "Era la voz de mi mamá. Pero mi mamá vive a trescientos kilómetros.", "tela": "celular_mensagem", "destaque": ["trescientos", "kilómetros."], "depois": 0.5},
    {"id": "l10", "voz": "narrador", "texto": "Y el teléfono... volvió a sonar.", "tela": "celular_de_novo", "destaque": ["volvió", "a", "sonar."], "depois": 1.0, "evento_fim": "toque_final"},
    {"id": "l11", "voz": "narrador", "texto": "¿Qué hago? ¿Abro la puerta, o contesto el teléfono? Comenta A o B. Lo que elijan, pasa en la parte dos.", "tela": "escolha", "destaque": ["A", "B."], "depois": 2.6}
  ],
  "escolhas": {
    "A": "ABRIR LA PUERTA",
    "B": "CONTESTAR EL TELÉFONO"
  }
}
